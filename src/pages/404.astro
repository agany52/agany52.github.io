---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/urls';
---

<BaseLayout title="Page not found | Alec Gany" description="The requested page could not be found.">
  <section class="not-found section-shell">
    <p class="eyebrow">404 · Page not found</p>
    <h1>This path does not lead to a case study.</h1>
    <p>The page may have moved, or the address may be incomplete.</p>
    <a class="button button-primary" href={withBase('')}>Return home</a>
  </section>
</BaseLayout>

