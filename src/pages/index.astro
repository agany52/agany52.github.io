---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { withBase } from '../lib/urls';
import headshot from '../assets/images/alec-gany-headshot.jpg';
import tornadoMap from '../assets/images/southeast-tornado-map.png';

const projects = (await getCollection('projects')).sort((a, b) => a.data.featuredOrder - b.data.featuredOrder);
const visualBySlug = {
  'healthcare-client-data-pipeline': 'healthcare',
  'operational-capacity-analysis': 'operations',
  'heart-disease-risk-prediction': 'heart',
  'sega-portfolio-analysis': 'sega',
} as const;
const shortTools: Record<string, string[]> = {
  'healthcare-client-data-pipeline': ['SQL Server', 'T-SQL', 'ETL', 'Data Quality', 'Stored Procedures'],
  'operational-capacity-analysis': ['Google Sheets', 'Operations', 'Weather context'],
  'heart-disease-risk-prediction': ['Python', 'scikit-learn', 'Random Forest'],
  'sega-portfolio-analysis': ['Python', 'Power BI', 'DAX'],
};
const evidenceBySlug: Record<string, string> = {
  'healthcare-client-data-pipeline': '24 synthetic source rows reconciled into 14 clean production encounters and 10 documented rejections; all three client checks passed.',
  'operational-capacity-analysis': 'Weekend scheduling operated closer to reported capacity; donation mix mattered more than weather alone.',
  'heart-disease-risk-prediction': 'Recall increased from 75% to about 90% at a 0.3 threshold, with 3 false negatives among 32 positive test cases.',
  'sega-portfolio-analysis': '1,402 records analyzed; PC represented 391 titles and showed greater user-score variability.',
};
---

<BaseLayout>
  <section class="hero section-shell">
    <div class="hero-copy">
      <p class="eyebrow">Applied Mathematics · Healthcare Technology · Data Analytics</p>
      <h1>Healthcare analytics grounded in real operations.</h1>
      <p class="hero-text">
        I use SQL, Python, Power BI, and operational experience to investigate healthcare data,
        identify workflow constraints, and communicate findings that support better decisions.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="#projects">Explore my work</a>
        <a class="button button-secondary" href={withBase('resume/Alec_Gany_Healthcare_Analytics_Resume.pdf')} download>
          Download résumé
        </a>
        <a class="button button-text" href="https://github.com/agany52" target="_blank" rel="noopener noreferrer">
          View GitHub <span aria-hidden="true">↗</span>
        </a>
      </div>
      <p class="availability"><span aria-hidden="true"></span> Madison, WI · Open to remote, hybrid, and relocation opportunities</p>
    </div>

    <div class="hero-profile">
      <div class="portrait-frame">
        <Image
          src={headshot}
          alt="Professional headshot of Alec Gany wearing a blue shirt and tie."
          widths={[320, 480, 640, 800]}
          sizes="(max-width: 760px) 78vw, 38vw"
          format="webp"
          loading="eager"
          fetchpriority="high"
        />
        <div class="portrait-caption">
          <p>Alec Gany</p>
          <span>Healthcare analytics · Applied data science</span>
        </div>
      </div>
      <div class="profile-note note-one" aria-hidden="true"><strong>40,000+</strong><span>patient records supported in remediation</span></div>
      <div class="profile-note note-two" aria-hidden="true"><strong>B.S.</strong><span>Applied Mathematics</span></div>
    </div>
  </section>

  <section class="proof-strip" aria-label="Professional foundation">
    <div class="section-shell proof-grid">
      <div><span>Foundation</span><strong>B.S. Applied Mathematics</strong></div>
      <div><span>Healthcare systems</span><strong>Epic Prelude · Cadence · RTE</strong></div>
      <div><span>Current context</span><strong>Frontline clinical operations</strong></div>
      <div><span>Analytics toolkit</span><strong>SQL · Python · Power BI · Excel</strong></div>
    </div>
  </section>

  <section id="projects" class="section-shell section-block projects-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2>Analysis built around decisions.</h2>
      </div>
      <p>Each case study defines the question, documents the method, and separates findings from limitations and recommended action.</p>
    </div>

    <div class="project-list">
      {projects.map((project, index) => (
        <ProjectCard
          slug={project.id}
          number={`0${index + 1}`}
          title={project.data.title}
          category={project.data.category}
          summary={project.data.shortSummary}
          evidence={evidenceBySlug[project.id]}
          tools={shortTools[project.id]}
          visual={visualBySlug[project.id as keyof typeof visualBySlug]}
          featured={index === 0}
        />
      ))}
    </div>
  </section>

  <section id="experience" class="experience-section">
    <div class="section-shell section-block">
      <div class="section-heading light-heading">
        <div>
          <p class="eyebrow">The experience bridge</p>
          <h2>Quantitative training meets healthcare systems and frontline operations.</h2>
        </div>
        <p>The career transition is grounded in three connected forms of evidence: mathematics, healthcare technology, and operational practice.</p>
      </div>

      <div class="experience-list">
        <article>
          <div class="experience-meta"><span>2023—Present</span><i aria-hidden="true"></i></div>
          <div>
            <p class="organization">American Red Cross</p>
            <h3>Blood Collections Technician I · Phlebotomy Instructor</h3>
            <p>Coordinate donor flow, equipment, documentation, training, and competing priorities in a regulated, capacity-constrained clinical environment. Use scheduling information and operational reports to identify bottlenecks and support safe, timely service.</p>
          </div>
        </article>
        <article>
          <div class="experience-meta"><span>2022—2023</span><i aria-hidden="true"></i></div>
          <div>
            <p class="organization">Epic Systems</p>
            <h3>Technical Solutions Engineer</h3>
            <p>Investigated software, data, and healthcare workflow issues across Epic Prelude, Cadence, and Real-Time Eligibility. Contributed to remediation of more than 40,000 patient records while maintaining data integrity and communicating across technical and nontechnical teams.</p>
          </div>
        </article>
        <article>
          <div class="experience-meta"><span>Class of 2022</span><i aria-hidden="true"></i></div>
          <div>
            <p class="organization">Franciscan University of Steubenville</p>
            <h3>B.S. Applied Mathematics · Magna Cum Laude · 3.8 GPA</h3>
            <p>Built a rigorous foundation in quantitative reasoning, modeling, and structured problem solving.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section id="toolkit" class="section-shell section-block toolkit-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Evidence-based toolkit</p>
        <h2>Tools tied to work shown here.</h2>
      </div>
      <p>No proficiency meters—just the technologies and methods demonstrated in projects or professional experience.</p>
    </div>
    <div class="skill-grid">
      <article>
        <span class="skill-number">01</span>
        <h3>Analysis & modeling</h3>
        <p>SQL, Python, Pandas, scikit-learn, data cleaning, classification metrics, descriptive analysis</p>
      </article>
      <article>
        <span class="skill-number">02</span>
        <h3>Reporting & BI</h3>
        <p>Power BI, DAX, Excel, Google Sheets, dashboard reporting, data validation</p>
      </article>
      <article>
        <span class="skill-number">03</span>
        <h3>Healthcare systems</h3>
        <p>Epic Prelude, Cadence, Real-Time Eligibility, workflow analysis, technical documentation</p>
      </article>
      <article>
        <span class="skill-number">04</span>
        <h3>Operational practice</h3>
        <p>Root-cause analysis, constrained-resource planning, training, quality standards, stakeholder communication</p>
      </article>
    </div>
  </section>

  <section class="additional-section">
    <div class="section-shell section-block">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Additional work</p>
          <h2>Smaller projects, broader range.</h2>
        </div>
        <p>Supporting work in APIs, local information tools, and geospatial analysis.</p>
      </div>

      <div class="additional-grid">
        <article class="additional-card weather-card">
          <div class="additional-visual" aria-hidden="true"><span>43.07° N</span><strong>Weather</strong><i>7-day forecast</i></div>
          <p class="project-kicker">PowerShell · Open-Meteo API</p>
          <h3>PS Weather API</h3>
          <p>A PowerShell utility that retrieves Madison's current conditions and seven-day forecast, calculates weather-adjusted temperatures, and renders condition-specific terminal output.</p>
          <a class="text-link" href="https://github.com/agany52/PS-Weather-API" target="_blank" rel="noopener noreferrer">View repository <span aria-hidden="true">↗</span></a>
        </article>

        <article class="additional-card scout-card">
          <div class="additional-visual" aria-hidden="true"><span>Madison, WI</span><strong>608 Scout</strong><i>Weather-aware prototype</i></div>
          <p class="project-kicker">Streamlit · Open-Meteo · Gemini</p>
          <h3>608 Scout</h3>
          <p>A Streamlit prototype combining date-specific weather data with AI-generated local event suggestions. Suggestions are generated examples, not a verified live event feed.</p>
          <a class="text-link" href="https://github.com/agany52/608-Scout" target="_blank" rel="noopener noreferrer">View repository <span aria-hidden="true">↗</span></a>
        </article>

        <article class="additional-card gis-card">
          <div class="map-thumb">
            <Image
              src={tornadoMap}
              alt="Map of 2023 tornado events across the Southeast and Mid-Atlantic United States, colored by Enhanced Fujita scale intensity."
              widths={[420, 640, 840]}
              sizes="(max-width: 760px) 92vw, 30vw"
              format="webp"
              loading="lazy"
            />
          </div>
          <p class="project-kicker">QGIS · NOAA Storm Events</p>
          <h3>Southeast Tornado Analysis</h3>
          <p>A geospatial view of 2023 tornado events by EF-scale intensity, with attention to coastal clustering, Dixie Alley, terrain, and reporting bias. Basemap © OpenStreetMap contributors.</p>
          <a class="text-link" href="https://github.com/agany52/GIS-Projects/tree/main/Southeast-Tornado-Analysis" target="_blank" rel="noopener noreferrer">View project folder <span aria-hidden="true">↗</span></a>
        </article>
      </div>
    </div>
  </section>

  <section id="about" class="section-shell section-block about-section">
    <div>
      <p class="eyebrow">About</p>
      <h2>Technical detail, human consequence.</h2>
    </div>
    <div class="about-copy">
      <p>My strongest work sits where technical detail meets human consequence. I earned a B.S. in Applied Mathematics, supported healthcare software and data workflows at Epic, and now work inside a highly regulated frontline healthcare operation.</p>
      <p>That combination shapes how I approach analysis: define the decision clearly, respect the limits of the data, and explain the result so someone can act on it.</p>
      <p>I am most interested in healthcare analytics, applied data science, business intelligence, operational analytics, and systems roles where analytical work improves how care and services are delivered.</p>
    </div>
  </section>

  <section class="section-shell contact-section">
    <div>
      <p class="eyebrow">Let’s connect</p>
      <h2>Interested in analytics that can improve real operations?</h2>
      <p>Open to healthcare analytics, applied data science, business intelligence, and systems opportunities.</p>
    </div>
    <div class="contact-actions">
      <a class="button button-lime" href="mailto:agany524@gmail.com">Start a conversation</a>
      <a href="https://linkedin.com/in/alec-gany" target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
